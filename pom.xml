<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.spacerng</groupId>
    <artifactId>sol-rng</artifactId>
    <version>253</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.helpch.at/releases</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Vault: only used to read real Money balances for the scoreboard.
             Soft-dependency at runtime - the plugin works fine without Vault
             installed, "Money" just shows as N/A. -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- PlaceholderAPI: exposes %solrng_tag% so TAB (which overrides the
             vanilla tab list) can be configured to show the equipped tag
             there. Soft-dependency - the plugin works fine without it. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- JDA: the Discord bot, ours since V230. DiscordSRV's JDA is too
             old to open a modal, which the link button needs. Shaded into
             SpaceRNG.jar and relocated (see the shade plugin below), so it
             can never meet DiscordSRV's copy or any other plugin's. Voice
             is left out: opus-java and tink only serve audio. slf4j is
             Paper's own. -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>5.6.1</version>
            <exclusions>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.crypto.tink</groupId>
                    <artifactId>tink</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <!-- Always SpaceRNG.jar, so a new upload on Minehut replaces the old file. -->
        <finalName>SpaceRNG</finalName>
        <!--
            plugin.yml is filtered so its version comes from <version> above
            and /version SpaceRNG reports the real build. Since the jar name
            carries no version any more, this is the only way to tell which
            build a server is running.

            Filtering is scoped to plugin.yml on purpose. config.yml is full
            of glyphs and colour codes and must be copied through byte for
            byte, so it goes in a second, unfiltered block.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation><pattern>net.dv8tion</pattern><shadedPattern>com.spacerng.libs.jda</shadedPattern></relocation>
                                <relocation><pattern>okhttp3</pattern><shadedPattern>com.spacerng.libs.okhttp3</shadedPattern></relocation>
                                <relocation><pattern>okio</pattern><shadedPattern>com.spacerng.libs.okio</shadedPattern></relocation>
                                <relocation><pattern>kotlin</pattern><shadedPattern>com.spacerng.libs.kotlin</shadedPattern></relocation>
                                <relocation><pattern>com.fasterxml</pattern><shadedPattern>com.spacerng.libs.fasterxml</shadedPattern></relocation>
                                <relocation><pattern>com.neovisionaries</pattern><shadedPattern>com.spacerng.libs.neovisionaries</shadedPattern></relocation>
                                <relocation><pattern>gnu.trove</pattern><shadedPattern>com.spacerng.libs.trove</shadedPattern></relocation>
                                <relocation><pattern>org.apache.commons.collections4</pattern><shadedPattern>com.spacerng.libs.collections4</shadedPattern></relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
