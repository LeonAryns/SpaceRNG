<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.spacerng</groupId>
    <artifactId>sol-rng</artifactId>
    <version>183</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.helpch.at/releases</url>
        </repository>
        <repository>
            <id>scarsz</id>
            <url>https://nexus.scarsz.me/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Vault: only used to read real Money balances for the scoreboard.
             Soft-dependency at runtime - the plugin works fine without Vault
             installed, "Money" just shows as N/A. -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- PlaceholderAPI: exposes %solrng_tag% so TAB (which overrides the
             vanilla tab list) can be configured to show the equipped tag
             there. Soft-dependency - the plugin works fine without it. -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- DiscordSRV: it already runs the bot, holds the Discord connection
             and knows which Discord account belongs to which player, so the
             slash commands and the role sync ride on that rather than on a
             second program with a second token. Provided, so nothing of it
             ships inside SpaceRNG.jar, and every call is guarded: without
             DiscordSRV installed the bot is simply never built. JDA lives
             relocated inside this jar, which is why the imports say
             github.scarsz.discordsrv.dependencies.jda. -->
        <dependency>
            <groupId>com.discordsrv</groupId>
            <artifactId>discordsrv</artifactId>
            <version>1.29.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Always SpaceRNG.jar, so a new upload on Minehut replaces the old file. -->
        <finalName>SpaceRNG</finalName>
        <!--
            plugin.yml is filtered so its version comes from <version> above
            and /version SpaceRNG reports the real build. Since the jar name
            carries no version any more, this is the only way to tell which
            build a server is running.

            Filtering is scoped to plugin.yml on purpose. config.yml is full
            of glyphs and colour codes and must be copied through byte for
            byte, so it goes in a second, unfiltered block.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </build>
</project>
